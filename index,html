// ======================================================
function evaluateHand(cards){
  const n=cards.length;
  if(n===0)return{type:'HighCard',scoring:[]};
  // Wild cards count as any suit
  const byRank={};
  cards.forEach(c=>{(byRank[c.rank]=byRank[c.rank]||[]).push(c);});
  const groups=Object.values(byRank).sort((a,b)=>b.length-a.length||b[0].rank-a[0].rank);
  const smeared=S&&S.jokers&&S.jokers.some(j=>j.key==='smearedJoker');
  const colorOf=(s)=>(s==='H'||s==='D')?'red':'black';
  const isFlush=n===5&&cards.every(c=>c.enh==='wild'||(smeared?colorOf(c.suit)===colorOf(cards[0].suit):c.suit===cards[0].suit));
  const ranksSet=[...new Set(cards.map(c=>c.rank))].sort((a,b)=>a-b);
  let isStraight=false;
  if(n===5&&ranksSet.length===5){if(ranksSet[4]-ranksSet[0]===4)isStraight=true;else if(ranksSet.join(',')==='2,3,4,5,14')isStraight=true;}
  // Special hands
  if(n===5&&groups[0].length===5)return{type:'FiveKind',scoring:[...groups[0]]};
  if(n===5&&groups[0].length===3&&groups[1].length===2&&isFlush)return{type:'FlushHouse',scoring:[...cards]};
  if(n===5&&groups[0].length===5&&isFlush)return{type:'FlushFive',scoring:[...cards]};
  if(isStraight&&isFlush)return{type:'StraightFlush',scoring:[...cards]};
  if(groups[0].length===4)return{type:'FourKind',scoring:[...groups[0]]};
  if(groups[0].length===3&&groups[1]&&groups[1].length===2)return{type:'FullHouse',scoring:[...groups[0],...groups[1]]};
  if(isFlush)return{type:'Flush',scoring:[...cards]};
  if(isStraight)return{type:'Straight',scoring:[...cards]};
  if(groups[0].length===3)return{type:'ThreeKind',scoring:[...groups[0]]};
  if(groups[0].length===2&&groups[1]&&groups[1].length===2)return{type:'TwoPair',scoring:[...groups[0],...groups[1]]};
  if(groups[0].length===2)return{type:'Pair',scoring:[...groups[0]]};
  const highest=cards.reduce((a,b)=>b.rank>a.rank?b:a,cards[0]);
  return{type:'HighCard',scoring:[highest]};
}

// ======================================================
// SCORING
// ======================================================
function buildScoreSteps(playedCards){
  const{type,scoring}=evaluateHand(playedCards);
  const ht=HAND_TYPES[type]||HAND_TYPES.HighCard;
  const lvl=S.handLevels[type]||1;
  let baseChips=ht.chips+ht.chipInc*(lvl-1);
  let baseMult=ht.mult+ht.multInc*(lvl-1);
  // Flint mode
  if(S.flintMode){baseChips=Math.round(baseChips*0.5);baseMult=Math.max(1,Math.round(baseMult*0.5));}
  const steps=[{label:`${ht.name} · Cấp ${lvl}${S.flintMode?' (Flint -50%)':''}`,chipDelta:baseChips,multDelta:baseMult,multMulti:1,delay:600,big:true}];
  let runningChips=baseChips,runningMult=baseMult;

  const effScoring=scoring.filter(c=>!(S.debuffSuit&&c.suit===S.debuffSuit&&c.enh!=='wild'));
  const debuffed=scoring.filter(c=>S.debuffSuit&&c.suit===S.debuffSuit&&c.enh!=='wild');
  debuffed.forEach(c=>{steps.push({label:'Chất bị vô hiệu',chipDelta:0,multDelta:0,multMulti:1,targetSel:`[data-cid="${c.id}"]`,floatText:'✕',floatColor:'#9aa',delay:110});});

  effScoring.forEach(c=>{
    let cc=rankChips(c.rank);
    if(c.enh==='bonus')cc+=30;
    if(c.enh==='stone')cc=50;
    if(c.enh==='wild')cc+=10;
    if(c.edition==='foil')cc+=50;
    let mDelta=0,mMulti=1,luckyHit=false,moneyGain=0;
    if(c.enh==='mult')mDelta+=4;
    if(c.edition==='holo')mDelta+=10;
    if(c.enh==='glass')mMulti*=2;
    if(c.edition==='poly')mMulti*=1.5;
    if(c.enh==='lucky'&&Math.random()<0.2){mDelta+=20;luckyHit=true;}
    if(c.enh==='lucky'&&Math.random()<0.07){moneyGain+=20;}
    // Seals during scoring
    if(c.seal==='gold'){moneyGain+=3;}
    if(c.seal==='red'){mMulti*=1.5;} // simplified: red seal = 1.5x
    runningChips+=cc;runningMult+=mDelta;runningMult*=mMulti;
    if(moneyGain)S.money+=moneyGain;
    let ft='';
    if(cc)ft+=`+${cc}`;
    if(mDelta)ft+=(ft?' ':'')+`+${mDelta}✦`;
    if(mMulti!==1)ft+=(ft?' ':'')+`x${mMulti.toFixed(1)}✦`;
    if(luckyHit)ft+=' 🍀';
    if(moneyGain)ft+=` +$${moneyGain}`;
    steps.push({label:`${rankLabel(c.rank)}${SUITS[c.suit].sym}`,chipDelta:cc,multDelta:mDelta,multMulti:mMulti,targetSel:`[data-cid="${c.id}"]`,floatText:ft,floatColor:(mDelta||mMulti!==1)?'#ff6b6b':'#5eb3f0',delay:150});
    // Glass might break
    if(c.enh==='glass'&&Math.random()<0.25){S.glassJokerCount=(S.glassJokerCount||0)+1;c.enh='none';}
    // Wee joker
    if(c.rank===2){S.weeJokerChips=(S.weeJokerChips||0)+8;}
  });

  const heldCards=S.hand.filter(c=>!playedCards.find(p=>p.id===c.id));
  heldCards.forEach(c=>{
    if(c.enh==='steel'){runningMult*=1.5;steps.push({label:'Steel (giữ tay)',chipDelta:0,multDelta:0,multMulti:1.5,targetSel:`[data-cid="${c.id}"]`,floatText:'x1.5✦',floatColor:'#ff6b6b',delay:150});}
  });

  let spaceLeveled=false;
  S.jokers.forEach(j=>{
    const def=JOKERS[j.key];if(!def)return;
    const ed=JOKER_EDITIONS[j.edition||'none']||JOKER_EDITIONS.none;
    const ctx={handType:type,scoringCards:effScoring,playedCards,heldCards,state:S,chips:runningChips,mult:runningMult,ownedJokerCount:activeJokerCount(),self:j};
    const res=def.calc(ctx)||{};
    const chipDelta=(res.chips||0)+(ed.chips||0);
    const multDelta=(res.mult||0)+(ed.mult||0);
    const multMulti=(res.xmult||1)*(ed.xmult||1);
    if(chipDelta||multDelta||multMulti!==1){
      runningChips+=chipDelta;runningMult+=multDelta;runningMult*=multMulti;
      let ft='';
      if(chipDelta)ft+=`+${Math.round(chipDelta)}`;
      if(multDelta)ft+=(ft?' ':'')+`+${Math.round(multDelta)}✦`;
      if(multMulti!==1)ft+=(ft?' ':'')+`x${Math.round(multMulti*100)/100}✦`;
      const label=def.name+(ed.name?` ✦${ed.name}`:'');
      steps.push({label,chipDelta,multDelta,multMulti,targetSel:`[data-juid="${j.uid}"]`,floatText:ft,floatColor:(chipDelta&&!multDelta&&multMulti===1)?'#5eb3f0':'#ff6b6b',delay:260});
    }
    if(def.passive==='spaceUp'&&Math.random()<0.25)spaceLeveled=true;
    if(def.key==='greenJoker')S.greenJokerMult=(S.greenJokerMult||0)+1;
    if(def.key==='ride'){const hasFace=playedCards.some(c=>c.rank>=11&&c.rank<=13);if(!hasFace)S.rideBusMult=(S.rideBusMult||0)+1;}
  });
  // Streak bonus
  if(S.streak>2){const bonus=S.streak*5;runningMult+=bonus;steps.push({label:`🔥 Streak x${S.streak} Bonus!`,chipDelta:0,multDelta:bonus,multMulti:1,floatText:`+${bonus}✦`,floatColor:'#ff9900',delay:200});}

  const total=Math.round(Math.max(0,runningChips)*Math.max(1,runningMult));
  S.handPlayCounts[type]=(S.handPlayCounts[type]||0)+1;
  return{type,scoring,steps,chips:runningChips,mult:runningMult,total,spaceLeveled};
}

