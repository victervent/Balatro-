// UNO Reverse
function unoReverse(pl){
 if(!pl.length||S.phase!=='playing'||S.currentScore>=S.blindScore||S.handsLeft<=0)return;
 const ids=new Set(pl.map(c=>c.id));
 pl.forEach(c=>{if(!S.hand.some(h=>h.id===c.id))S.hand.push(c);});
 while(S.hand.length>S.handSize){
  const cand=S.hand.filter(c=>!ids.has(c.id));if(!cand.length)break;
  const v=pick(cand);S.hand=S.hand.filter(c=>c!==v);S.deck.push(v);
 }
 applySort();S.justDealt=true;S.selected=[];
 S.message='🔄 UNO Reverse! Các lá vừa đánh quay lại tay bạn!';
 say('🔄 UNO REVERSE!','#ff6b6b');render();
}

