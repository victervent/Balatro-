<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>ARCANUM ANTE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Baloo+2:wght@500;600;700;800&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
                <link rel="icon" type="image/x-icon" href="https://cdn11.dienmaycholon.vn/filewebdmclnew/public/userupload/files/Image%20FP_2024/hinh-anime-2.jpg">
<style>
:root{
  --felt-1:#0e3b2e; --felt-2:#0a2a21; --felt-edge:#082019;
  --gold:#f0b84b; --gold-2:#c9902f; --cream:#f4ecd8; --ink:#182018;
  --red:#e0495a; --blue-mystic:#6f7bd6; --purple-mystic:#9a5fc9;
  --planet-teal:#3fb8a6; --panel:#123527; --panel-edge:#1d5440;
  --danger:#e05a4e; --good:#7fd18b; --text-hi:#f7f1de; --text-lo:#b9d3c4;
  --font-display:'Baloo 2',system-ui,sans-serif;
  --font-mono:'Silkscreen',monospace; --font-body:'Nunito Sans',system-ui,sans-serif;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:radial-gradient(ellipse at 50% -10%,#1a5a45 0%,var(--felt-1) 45%,var(--felt-2) 100%);
  background-attachment:fixed; color:var(--text-hi); font-family:var(--font-body);
  min-height:100vh; overflow-x:hidden; -webkit-font-smoothing:antialiased;
}
body::before{content:"";position:fixed;inset:0;background-image:radial-gradient(circle at 20% 30%,rgba(255,255,255,0.035) 0,transparent 40%),radial-gradient(circle at 80% 70%,rgba(255,255,255,0.03) 0,transparent 40%);pointer-events:none;z-index:0;}
#app{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:10px 12px 28px;}
::-webkit-scrollbar{height:8px;width:8px;}
::-webkit-scrollbar-thumb{background:var(--panel-edge);border-radius:6px;}
button{font-family:var(--font-body);cursor:pointer;border:none;outline:none;}
button:focus-visible,[tabindex]:focus-visible,.card:focus-visible{outline:3px solid var(--gold);outline-offset:2px;}
@media(prefers-reduced-motion:reduce){*{animation-duration:0.01ms!important;transition-duration:0.01ms!important;}}

/* ===== HUD ===== */
.hud{display:grid;grid-template-columns:1.1fr 1.4fr 1fr;gap:10px;margin-bottom:12px;}
@media(max-width:760px){.hud{grid-template-columns:1fr 1fr;grid-template-areas:"blind blind" "score score" "stats stats";}.hud>.blind-box{grid-area:blind;}.hud>.score-box{grid-area:score;}.hud>.stats-box{grid-area:stats;}}
.panel{background:linear-gradient(180deg,var(--panel),#0d2b20);border:2px solid var(--panel-edge);border-radius:14px;padding:10px 14px;box-shadow:0 6px 0 rgba(0,0,0,0.25),inset 0 1px 0 rgba(255,255,255,0.05);}
.blind-box .name{font-family:var(--font-display);font-weight:800;font-size:1.05rem;color:var(--gold);letter-spacing:0.2px;}
.blind-box .sub{font-size:0.78rem;color:var(--text-lo);margin-top:2px;}
.boss-tag{display:inline-block;margin-top:6px;background:rgba(224,90,78,0.18);border:1px solid var(--danger);color:#ffb3ab;font-size:0.72rem;padding:3px 8px;border-radius:8px;}
.score-box{display:flex;flex-direction:column;justify-content:center;}
.score-row{display:flex;justify-content:space-between;align-items:baseline;font-family:var(--font-mono);}
.score-row .cur{font-size:1.3rem;color:var(--gold);}
.score-row .tgt{font-size:0.95rem;color:var(--text-lo);}
.bar{height:10px;border-radius:6px;background:#07190f;margin-top:8px;overflow:hidden;border:1px solid #0a2318;}
.bar-fill{height:100%;background:linear-gradient(90deg,var(--gold-2),var(--gold));transition:width .35s ease;}
.stats-box{display:flex;gap:12px;align-items:center;justify-content:space-around;}
.stat{text-align:center;}
.stat .num{font-family:var(--font-mono);font-size:1.15rem;color:var(--text-hi);}
.stat .lbl{font-size:0.66rem;color:var(--text-lo);text-transform:none;margin-top:1px;}
.stat.money .num{color:#8be08b;}

/* ===== STREAK BANNER ===== */
.streak-bar{display:flex;align-items:center;justify-content:center;gap:8px;padding:5px 14px;background:rgba(240,184,75,0.12);border:1px solid rgba(240,184,75,0.3);border-radius:8px;margin-bottom:8px;font-size:0.82rem;}
.streak-fire{font-size:1.1rem;animation:fireWobble 0.6s ease-in-out infinite alternate;}
@keyframes fireWobble{0%{transform:rotate(-8deg) scale(0.9);}100%{transform:rotate(8deg) scale(1.1);}}

/* ===== JOKER / CONSUMABLE ROWS ===== */
.row-label{font-size:0.72rem;color:var(--text-lo);margin:10px 2px 4px;display:flex;justify-content:space-between;}
.card-row{display:flex;gap:8px;padding:8px;overflow-x:auto;background:rgba(0,0,0,0.15);border-radius:12px;border:1px dashed rgba(255,255,255,0.12);min-height:96px;align-items:center;}
.slot-empty{flex:0 0 auto;width:64px;height:88px;border-radius:10px;border:2px dashed rgba(255,255,255,0.14);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.2);font-size:1.4rem;}
.joker-card,.consumable-card{position:relative;flex:0 0 auto;width:68px;height:92px;border-radius:10px;padding:6px 5px;display:flex;flex-direction:column;justify-content:space-between;color:#1b1420;font-size:0.6rem;line-height:1.1;cursor:pointer;box-shadow:0 4px 0 rgba(0,0,0,0.3);border:2px solid rgba(0,0,0,0.25);transition:transform .12s ease;}
.joker-card:hover,.consumable-card:hover{transform:translateY(-3px);}
.joker-card .jname,.consumable-card .jname{font-family:var(--font-display);font-weight:700;font-size:0.6rem;}
.joker-card .jicon,.consumable-card .cicon{font-size:1.3rem;text-align:center;}
.joker-card .jcount{font-size:0.58rem;color:rgba(0,0,0,0.55);text-align:center;}
.tt{position:absolute;bottom:100%;left:50%;transform:translateX(-50%) translateY(-6px);width:200px;background:#0b0b10;color:#f2ead2;border:1px solid var(--gold);border-radius:8px;padding:8px 9px;font-size:0.72rem;line-height:1.35;z-index:40;box-shadow:0 8px 18px rgba(0,0,0,0.5);pointer-events:none;display:none;}
.joker-card:hover .tt,.consumable-card:hover .tt{display:block;}
.tt .tt-name{font-family:var(--font-display);color:var(--gold);font-weight:700;margin-bottom:3px;font-size:0.78rem;}

/* ===== PLAYING FIELD ===== */
.field{margin-top:16px;}
.msg-banner{text-align:center;font-family:var(--font-display);font-weight:700;font-size:1rem;color:var(--gold);min-height:1.4em;margin-bottom:6px;letter-spacing:0.2px;}
.hand-wrap{display:flex;justify-content:center;align-items:flex-end;gap:0;padding:22px 6px 8px;min-height:172px;flex-wrap:wrap;}
.card{width:78px;height:110px;background:linear-gradient(160deg,#fdf8ec,#efe5cb);border-radius:9px;border:1px solid #cbb98f;margin:0 -14px;position:relative;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;padding:6px 7px;box-shadow:0 3px 6px rgba(0,0,0,0.35);transition:transform .15s ease,box-shadow .15s ease,margin .15s ease;user-select:none;}
.card:hover{transform:translateY(-10px);}
.card.selected{transform:translateY(-22px);box-shadow:0 10px 18px rgba(0,0,0,0.45),0 0 0 3px var(--gold);}
.card .rank{font-family:var(--font-mono);font-weight:700;font-size:0.95rem;}
.card .suit{font-size:1.5rem;text-align:center;}
.card .rank.bottom{align-self:flex-end;transform:rotate(180deg);}
.card.red{color:var(--red);}
.card.black{color:#1b1420;}
/* Enhancements */
.card.enh-bonus{background:linear-gradient(160deg,#fff7e0,#f3dfa8);border-color:#d9b45a;}
.card.enh-mult{background:linear-gradient(160deg,#ffe3e3,#f3b8b8);border-color:#d97a7a;}
.card.enh-glass{background:linear-gradient(160deg,#eafcff,#c9eef5);border-color:#7fd6e8;}
.card.enh-steel{background:linear-gradient(160deg,#eef0f5,#cfd4e0);border-color:#9aa3b8;}
.card.enh-gold{background:linear-gradient(160deg,#fff3c4,#f0cd5c);border-color:#c99b1f;}
.card.enh-lucky{background:linear-gradient(160deg,#e9ffe9,#bdeecb);border-color:#6bd18a;}
.card.enh-stone{background:linear-gradient(160deg,#e7e4de,#c9c4ba);border-color:#9c948a;color:#3a352e;}
.card.enh-wild{background:linear-gradient(160deg,#fff0ff,#e8c8ff);border-color:#b06ad4;}
.card.enh-glass.in-play{box-shadow:0 0 12px 4px rgba(127,214,232,0.6);}
/* Editions */
.card .edition-tag{position:absolute;top:2px;right:3px;font-size:0.5rem;padding:1px 3px;border-radius:4px;font-family:var(--font-mono);}
.card.ed-foil .edition-tag{background:#dfe9ea;color:#2c5a5c;}
.card.ed-holo .edition-tag{background:#e7dcff;color:#5b3a99;}
.card.ed-poly .edition-tag{background:linear-gradient(90deg,#ffd1e0,#c9d1ff);color:#5a2a5f;}
.card.ed-neg .edition-tag{background:#3a3a3a;color:#f0e6ff;}
/* Seals */
.card .seal-tag{position:absolute;bottom:3px;left:4px;width:13px;height:13px;border-radius:50%;font-size:0.5rem;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-weight:700;box-shadow:0 1px 2px rgba(0,0,0,0.4);}
/* Debuff */
.card.debuffed{filter:grayscale(0.7) brightness(0.8);}
.card.debuffed::after{content:"✕";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:2rem;color:rgba(200,80,80,0.7);pointer-events:none;}

/* Controls */
.controls{display:flex;justify-content:center;gap:10px;margin-top:8px;flex-wrap:wrap;}
.btn{font-family:var(--font-display);font-weight:700;font-size:0.9rem;letter-spacing:0.2px;padding:11px 22px;border-radius:10px;color:var(--ink);background:linear-gradient(180deg,#ffdd88,var(--gold));box-shadow:0 4px 0 var(--gold-2);transition:transform .08s ease,box-shadow .08s ease;}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--gold-2);}
.btn.secondary{background:linear-gradient(180deg,#e3e9ea,#b9c3c4);box-shadow:0 4px 0 #8a9394;}
.btn.danger{background:linear-gradient(180deg,#ff9d8f,var(--danger));box-shadow:0 4px 0 #a5342a;color:#2a0e0a;}
.btn.ghost{background:linear-gradient(180deg,#1d5440,#123527);color:var(--text-hi);box-shadow:0 4px 0 #082019;border:1px solid var(--panel-edge);}
.btn.purple{background:linear-gradient(180deg,#c084fc,#9a5fc9);box-shadow:0 4px 0 #6a3d99;color:#fff;}
.btn:disabled{opacity:0.4;cursor:not-allowed;transform:none;box-shadow:0 4px 0 rgba(0,0,0,0.2);}
.btn.small{padding:7px 14px;font-size:0.78rem;}
.hint{text-align:center;font-size:0.75rem;color:var(--text-lo);margin-top:6px;}

/* ===== BLIND INTRO ===== */
.overlay{position:fixed;inset:0;background:rgba(4,12,9,0.82);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;z-index:100;padding:16px;}
.modal{background:linear-gradient(180deg,#134231,#0c2c20);border:2px solid var(--panel-edge);border-radius:18px;padding:22px;max-width:560px;width:100%;box-shadow:0 20px 50px rgba(0,0,0,0.5);max-height:88vh;overflow-y:auto;}
.modal h2{font-family:var(--font-display);color:var(--gold);margin:0 0 4px;font-size:1.4rem;display:flex;align-items:center;gap:8px;}
.modal p{color:var(--text-lo);font-size:0.88rem;line-height:1.5;}
.blind-list{display:flex;flex-direction:column;gap:10px;margin-top:14px;}
.blind-item{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-radius:12px;border:2px solid var(--panel-edge);background:rgba(0,0,0,0.18);}
.blind-item.active{border-color:var(--gold);background:rgba(240,184,75,0.08);}
.blind-item.boss-row{border-color:var(--danger);background:rgba(224,90,78,0.06);}
.blind-item .bi-name{font-family:var(--font-display);font-weight:700;display:flex;align-items:center;gap:6px;}
.blind-item .bi-score{font-family:var(--font-mono);color:var(--gold);font-size:1.05rem;}
.blind-item .bi-reward{font-size:0.75rem;color:var(--good);}
.blind-icon{font-size:1.15rem;}

/* ===== TAG ===== */
.tag-reveal{text-align:center;}
.tag-reveal .tag-icon{font-size:2.6rem;margin:6px 0;}
.tag-reveal .tag-name{font-family:var(--font-display);color:var(--gold);font-size:1.2rem;font-weight:700;}
.tag-reveal .tag-result{color:var(--good);font-size:0.9rem;margin-top:6px;}

/* ===== SHOP ===== */
.shop-wrap{margin-top:10px;}
.shop-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px;}
.shop-header h2{font-family:var(--font-display);color:var(--gold);margin:0;font-size:1.3rem;}
.shop-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:12px;margin-bottom:16px;}
.shop-item{background:linear-gradient(180deg,#164a37,#0e3527);border:2px solid var(--panel-edge);border-radius:12px;padding:10px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;}
.shop-item .icon{font-size:1.8rem;}
.shop-item .nm{font-family:var(--font-display);font-weight:700;font-size:0.78rem;min-height:2em;}
.shop-item .dsc{font-size:0.66rem;color:var(--text-lo);min-height:3.6em;line-height:1.3;}
.shop-item .price{font-family:var(--font-mono);color:var(--good);font-size:0.85rem;}
.shop-owned{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;}
.own-chip{display:flex;align-items:center;gap:6px;background:rgba(0,0,0,0.25);border:1px solid var(--panel-edge);border-radius:20px;padding:5px 10px 5px 8px;font-size:0.72rem;}
.own-chip button{background:rgba(224,90,78,0.25);color:#ffcfc9;border-radius:12px;padding:2px 8px;font-size:0.65rem;}

/* ===== PACK PICK MODAL ===== */
.pack-grid{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:14px;}
.pack-card{background:linear-gradient(180deg,#164a37,#0e3527);border:2px solid var(--panel-edge);border-radius:14px;padding:14px;width:140px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;cursor:pointer;transition:transform .12s,border-color .12s;}
.pack-card:hover{transform:translateY(-4px);border-color:var(--gold);}
.pack-card .pi{font-size:2rem;}
.pack-card .pnm{font-family:var(--font-display);font-weight:700;font-size:0.82rem;}
.pack-card .pdesc{font-size:0.68rem;color:var(--text-lo);}

/* ===== VOUCHER / PACK ITEM ===== */
.pack-item{border-color:var(--blue-mystic)!important;}
.voucher-item{border-color:var(--gold)!important;}

/* ===== GAME OVER ===== */
.center-screen{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:70vh;text-align:center;gap:10px;}
.center-screen h1{font-family:var(--font-display);font-size:2.4rem;color:var(--gold);margin:0;}
.center-screen p{color:var(--text-lo);max-width:420px;}
.center-screen .final-stats{background:rgba(0,0,0,0.3);border-radius:12px;padding:14px 20px;margin:8px 0;text-align:left;font-size:0.88rem;}
.center-screen .final-stats span{display:block;margin:4px 0;color:var(--text-lo);}
.center-screen .final-stats b{color:var(--gold);}

/* ===== SELECT MODE ===== */
.select-mode-banner{text-align:center;background:rgba(154,95,201,0.18);border:1px solid var(--purple-mystic);color:#e6d4f7;padding:8px 12px;border-radius:10px;font-size:0.82rem;margin-bottom:6px;}

/* ===== FABs ===== */
.rules-toggle{position:fixed;bottom:14px;right:14px;z-index:60;}
.library-toggle{position:fixed;bottom:14px;left:14px;z-index:60;}
.rules-fab{width:42px;height:42px;border-radius:50%;background:var(--gold);color:var(--ink);font-family:var(--font-display);font-weight:800;box-shadow:0 4px 10px rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;font-size:1.1rem;}

/* ===== LIBRARY ===== */
.lib-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 14px;}
.lib-tab-btn{padding:7px 12px;border-radius:20px;font-size:0.76rem;font-family:var(--font-display);font-weight:700;background:rgba(0,0,0,0.25);color:var(--text-lo);border:1px solid var(--panel-edge);}
.lib-tab-btn.active{background:var(--gold);color:var(--ink);border-color:var(--gold-2);}
.lib-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(128px,1fr));gap:10px;max-height:52vh;overflow-y:auto;padding-right:4px;}
.lib-item{background:linear-gradient(180deg,#164a37,#0e3527);border:2px solid var(--panel-edge);border-radius:12px;padding:9px;display:flex;flex-direction:column;gap:4px;text-align:center;}
.lib-item.owned{border-color:var(--good);}
.lib-item .lib-icon{font-size:1.5rem;}
.lib-item .lib-name{font-family:var(--font-display);font-weight:700;font-size:0.72rem;}
.lib-item .lib-desc{font-size:0.62rem;color:var(--text-lo);line-height:1.3;min-height:2.8em;}
.lib-item .lib-meta{font-size:0.62rem;color:var(--gold);font-family:var(--font-mono);}
.deck-note{font-size:0.78rem;margin:0 0 10px;color:var(--text-lo);}
.deck-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(46px,1fr));gap:6px;max-height:50vh;overflow-y:auto;padding:4px;}
.deck-mini{width:46px;height:62px;border-radius:6px;background:linear-gradient(160deg,#fdf8ec,#efe5cb);border:1px solid #cbb98f;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-family:var(--font-mono);font-weight:700;font-size:0.68rem;position:relative;}
.deck-mini.red{color:var(--red);} .deck-mini.black{color:#1b1420;}
.deck-mini .dm-suit{font-size:0.95rem;}
.deck-mini .dm-tag{font-size:0.46rem;font-family:var(--font-body);color:#7a6a3a;background:#f0dfa0;border-radius:3px;padding:0 3px;}
.hand-levels{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.hl-row{display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:rgba(0,0,0,0.2);border-radius:8px;border:1px solid var(--panel-edge);font-size:0.78rem;}
.hl-row .hl-name{color:var(--text-lo);}
.hl-row .hl-val{font-family:var(--font-mono);color:var(--gold);}

/* ===== ANIMATIONS ===== */
.sparkles{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;}
.spark{position:absolute;width:3px;height:3px;background:var(--gold);border-radius:50%;box-shadow:0 0 6px 2px rgba(240,184,75,0.6);opacity:0;animation:twinkle 4.5s ease-in-out infinite;}
@keyframes twinkle{0%,100%{opacity:0;transform:scale(0.4);}50%{opacity:0.85;transform:scale(1.3);}}
.card,.joker-card,.consumable-card{overflow:hidden;}
.card::after,.joker-card::after,.consumable-card::after{content:"";position:absolute;top:0;left:-60%;width:35%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,0.55),transparent);transform:skewX(-20deg);opacity:0;pointer-events:none;}
.card:hover::after,.joker-card:hover::after,.consumable-card:hover::after{opacity:1;animation:cardShine .65s ease;}
@keyframes cardShine{0%{left:-60%;}100%{left:130%;}}
.card.deal{animation:dealIn .34s cubic-bezier(.2,.8,.3,1) both;}
@keyframes dealIn{0%{transform:translateY(50px) scale(0.55) rotate(10deg);opacity:0;}100%{transform:translateY(0) scale(1) rotate(0);opacity:1;}}
.card.discard-out{animation:discardOut .26s ease forwards;pointer-events:none;}
@keyframes discardOut{to{transform:translateY(50px) scale(0.65) rotate(14deg);opacity:0;}}
.card.dragging{opacity:0.35;}
.card.in-play{cursor:default;transform:translateY(-6px);box-shadow:0 10px 18px rgba(0,0,0,0.45),0 0 0 2px rgba(240,184,75,0.55);}
.card.in-play:hover{transform:translateY(-6px);}
.hand-wrap.locked .card{opacity:0.45;filter:grayscale(0.35) saturate(0.7);pointer-events:none;transform:none;}
.joker-card.rarity-C{border-color:#8a7550;}
.joker-card.rarity-U{border-color:#3f6fae;}
.joker-card.rarity-R{border-color:#8a3fae;}
.joker-card.rarity-L{border-color:#e0a030;background:linear-gradient(160deg,#fff8e0,#f8d87a)!important;}
.card.hit{animation:cardHit .4s ease;}
@keyframes cardHit{0%{box-shadow:0 3px 6px rgba(0,0,0,0.35);}40%{transform:translateY(-16px) scale(1.12);box-shadow:0 0 18px 5px rgba(94,179,240,0.85);}100%{box-shadow:0 3px 6px rgba(0,0,0,0.35);}}
.card.in-play.hit{animation:cardHitPlay .4s ease;}
