let prevScore=0,prevKey='';
function animateScore(from,to){
 const fill=document.querySelector('.bar-fill'),cur=document.querySelector('.score-box .cur');
 if(fill){const p0=Math.min(100,from/S.blindScore*100),p1=Math.min(100,to/S.blindScore*100);fill.style.transition='none';fill.style.width=p0+'%';void fill.offsetWidth;fill.style.transition='width .8s cubic-bezier(.2,.8,.2,1)';fill.style.width=p1+'%';}
 if(cur){countUp(cur,from,to,800);cur.classList.add('score-bump');setTimeout(()=>cur.classList.remove('score-bump'),900);}
}
const _r=render;
render=function(){
 const dealFlag=!!(S&&S.justDealt),key=S?S.ante+'-'+S.blindIdx:'';
 const prev=(S&&S.phase==='playing'&&key===prevKey)?prevScore:null;
 _r();
 try{
  if(!S)return;
  document.body.dataset.phase=S.phase;
  if(S.phase==='shop')restructureShop();
  if(S.phase==='blind-intro')prevScore=0;
  if(dealFlag&&S.phase==='playing')document.querySelectorAll('.hand-wrap .card').forEach((el,k)=>{el.classList.add('deal');el.style.animationDelay=(k*45)+'ms';el.addEventListener('animationend',e=>{if(e.animationName==='dealIn'){el.classList.remove('deal');el.style.animationDelay='';}});});
  if(S.phase==='scoring'){const h=document.querySelector('.hand-wrap');if(h)h.classList.add('locked');}
  if(prev!==null&&S.currentScore>prev)animateScore(prev,S.currentScore);
  if(S.phase==='playing'||S.phase==='scoring')prevScore=S.currentScore;
  prevKey=key;
 }catch(e){console.error(e);}
};
