function rollJokerEdition(boost){const b=boost||0;const r=Math.random();if(r<0.006+0.002*b)return'negative';if(r<0.02+0.01*b)return'poly';if(r<0.06+0.02*b)return'holo';if(r<0.13+0.04*b)return'foil';return'none';}
function activeJokerCount(state){const st=state||S;return st.jokers.filter(j=>j.edition!=='negative').length;}
function jokerEditionTag(edition){if(!edition||edition==='none')return'';const map={foil:'FOIL',holo:'HOLO',poly:'POLY',negative:'NEG'};return`<span class="edition-tag-j">${map[edition]}</span>`;}

