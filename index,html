function cardClass(c){
  let cls='card '+SUITS[c.suit].color;
  if(c.enh&&c.enh!=='none')cls+=' enh-'+c.enh;
  if(c.edition==='foil')cls+=' ed-foil';
  if(c.edition==='holo')cls+=' ed-holo';
  if(c.edition==='poly')cls+=' ed-poly';
  if(c.edition==='negative')cls+=' ed-neg';
  return cls;
}
function editionTagHTML(c){
  if(c.edition==='foil')return'<span class="edition-tag">FOIL</span>';
  if(c.edition==='holo')return'<span class="edition-tag">HOLO</span>';
  if(c.edition==='poly')return'<span class="edition-tag">POLY</span>';
  return'';
}
function cardHTML(c,selected,dealIdx){
  const dealClass=(S.justDealt&&dealIdx!==undefined)?' deal':'';
  const dealStyle=(S.justDealt&&dealIdx!==undefined)?` style="animation-delay:${dealIdx*40}ms"`:'';
  const isDebuffed=S.debuffSuit&&c.suit===S.debuffSuit&&c.enh!=='wild';
  const suitDisplay=S.blindHandMode&&S.phase==='playing'?'?':SUITS[c.suit].sym;
  return `<div class="${cardClass(c)}${selected?' selected':''}${isDebuffed?' debuffed':''}${dealClass}" data-cid="${c.id}"${dealStyle} tabindex="0" role="button" aria-pressed="${selected}" draggable="true"
    onmousedown="event.preventDefault()"
    onclick="toggleSelect('${c.id}')"
    onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSelect('${c.id}');}"
    ondragstart="onCardDragStart(event,'${c.id}')"
    ondragover="onCardDragOver(event)"
    ondrop="onCardDrop(event,'${c.id}')"
    ondragend="onCardDragEnd(event)">
    ${editionTagHTML(c)}${sealTag(c)}
    <div class="rank">${rankLabel(c.rank)}</div>
    <div class="suit">${suitDisplay}</div>
    <div class="rank bottom">${rankLabel(c.rank)}</div>
  </div>`;
}

function jokerTooltip(def,edition){
  const ed=edition&&edition!=='none'?JOKER_EDITIONS[edition]:null;
  let edLine='';
  if(ed){const parts=[];if(ed.chips)parts.push(`+${ed.chips} Chip`);if(ed.mult)parts.push(`+${ed.mult} Mult`);if(ed.xmult)parts.push(`x${ed.xmult} Mult`);if(ed.slot)parts.push('Không chiếm khay');edLine=`<div style="margin-top:4px;color:#e0a9ff;">✦ ${ed.name}: ${parts.join(', ')}</div>`;}
  const rarityColors={C:'#aaa',U:'#6fa8dc',R:'#b48be0',L:'#f0b84b'};
  return `<div class="tt"><div class="tt-name">${def.name}</div><div style="font-size:0.65rem;color:${rarityColors[def.rarity]||'#aaa'};">${{C:'Thường',U:'Hiếm',R:'Rất hiếm',L:'Huyền thoại'}[def.rarity]}</div>${def.desc}${edLine}<div style="margin-top:4px;color:#c9a94a;">Bán: $${Math.max(1,Math.floor(def.cost/2))}</div></div>`;
}
function tarotTooltip(def){const range=def.max===0?'Không cần chọn':(def.min===def.max?`Chọn ${def.max} lá`:`Chọn 0-${def.max} lá`);return `<div class="tt"><div class="tt-name">${def.name}</div>${def.desc}<div style="margin-top:4px;color:#c9a94a;">${range}</div></div>`;}

function renderJokerRow(){
  let html='';
  S.jokers.forEach(j=>{
    const def=JOKERS[j.key];if(!def)return;
    const ed=j.edition||'none';
    const edClass=ed!=='none'?`ed-${ed}-j`:'';
    const rarClass=`rarity-${def.rarity}`;
    const bgMap={foil:'linear-gradient(160deg,#f6e7ff,#d9c4f0)',holo:'linear-gradient(160deg,#ece4ff,#b8a4e8)',poly:'linear-gradient(160deg,#ffd6ec,#c9d1ff)',negative:'linear-gradient(160deg,#3a3a3a,#1c1c1c)',none:'linear-gradient(160deg,#f6e7ff,#d9c4f0)'};
    const colorStyle=ed==='negative'?'color:#f0e6ff;':'';
    const bg=def.rarity==='L'?'linear-gradient(160deg,#fff8e0,#f8d87a)':(bgMap[ed]||bgMap.none);
    // Show accumulator for special jokers
    let extraInfo='';
    if(def.key==='greenJoker')extraInfo=`<div class="jcount">Mult: +${S.greenJokerMult||0}</div>`;
    if(def.key==='ride')extraInfo=`<div class="jcount">Mult: +${S.rideBusMult||0}</div>`;
    if(def.key==='glass')extraInfo=`<div class="jcount">x${(1+0.5*(S.glassJokerCount||0)).toFixed(1)}</div>`;
    if(def.key==='weeJoker')extraInfo=`<div class="jcount">+${S.weeJokerChips||0}🂮</div>`;
    if(def.key==='yorick')extraInfo=`<div class="jcount">+${Math.floor((S.totalDiscards||0)/23)}✦</div>`;
    html+=`<div class="joker-card ${edClass} ${rarClass}" data-juid="${j.uid}" style="background:${bg};${colorStyle}">${jokerEditionTag(ed)}${jokerTooltip(def,ed)}<div class="jicon">${def.icon}</div><div class="jname">${def.name}</div>${extraInfo}</div>`;
  });
  const empties=Math.max(0,S.maxJokerSlots-activeJokerCount());
  for(let i=0;i<empties;i++)html+=`<div class="slot-empty">+</div>`;
  return html;
}
function renderConsumRow(usable){
  let html='';
  S.consumables.forEach(c=>{
    const def=c.type==='planet'?PLANETS[c.key]:TAROTS[c.key];
    const bg=c.type==='planet'?'linear-gradient(160deg,#c9f3ea,#8fd9c9)':'linear-gradient(160deg,#e6d7f7,#c7a4e8)';
    const tt=c.type==='planet'?`<div class="tt"><div class="tt-name">${def.name}</div>Tăng cấp ${HAND_TYPES[def.hand].name} (cấp ${S.handLevels[def.hand]}).</div>`:tarotTooltip(def);
    html+=`<div class="consumable-card" style="background:${bg};" ${usable?`onclick="beginUseConsumable('${c.uid}')"`:''}>${tt}<div class="cicon">${def.icon}</div><div class="jname">${def.name}</div></div>`;
  });
  const empties=S.maxConsumableSlots-S.consumables.length;
  for(let i=0;i<empties;i++)html+=`<div class="slot-empty">✦</div>`;
  return html;
}

