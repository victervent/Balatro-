// Drag & drop
let dragCardId=null;
function onCardDragStart(e,id){dragCardId=id;if(e.dataTransfer){e.dataTransfer.effectAllowed='move';try{e.dataTransfer.setData('text/plain',id);}catch(err){}}if(e.currentTarget)setTimeout(()=>e.currentTarget.classList.add('dragging'),0);}
function onCardDragOver(e){e.preventDefault();if(e.dataTransfer)e.dataTransfer.dropEffect='move';}
function onCardDrop(e,targetId){
  e.preventDefault();const sourceId=dragCardId||(e.dataTransfer&&e.dataTransfer.getData('text/plain'));dragCardId=null;
  if(!sourceId||sourceId===targetId)return;
  const from=S.hand.findIndex(c=>c.id===sourceId);const to=S.hand.findIndex(c=>c.id===targetId);
  if(from<0||to<0)return;
  const[moved]=S.hand.splice(from,1);S.hand.splice(to,0,moved);S.sortMode='manual';render();
}
function onCardDragEnd(e){dragCardId=null;if(e.currentTarget)e.currentTarget.classList.remove('dragging');}

function playSelected(){
  if(S.phase!=='playing')return;
  if(S.selected.length===0||S.selected.length>5)return;
  if(S.mustPlayFive&&S.selected.length!==5){S.message='Boss "The Psychic" buộc phải chơi đúng 5 lá!';render();return;}
  const played=S.hand.filter(c=>S.selected.includes(c.id));
  const build=buildScoreSteps(played);
  S.scoringPlayed=played;
  S.hand=S.hand.filter(c=>!S.selected.includes(c.id));
  S.selected=[];
  S.phase='scoring';
  render();
  requestAnimationFrame(()=>runScoreAnimation(build,played,()=>finalizeScore(build)));
}

function finalizeScore(build){
  if(build.spaceLeveled)S.handLevels[build.type]=Math.min(10,(S.handLevels[build.type]||1)+1);
  S.currentScore+=build.total;S.totalScore+=build.total;S.lastResult=build;
  S.handsLeft-=1;S.totalHandsPlayed=(S.totalHandsPlayed||0)+1;
  // Streak
  S.streak=(S.streak||0)+1;S.bestStreak=Math.max(S.bestStreak||0,S.streak);
  // Fish mode: draw back to 1
  if(S.fishMode){S.hand=[];drawTo(1);}
  else{drawTo(S.handSize);}
  applySort();
  S.justDealt=true;
  const typeName=HAND_TYPES[build.type]?HAND_TYPES[build.type].name:build.type;
  S.message=`${typeName}! +${build.total.toLocaleString()} điểm${S.streak>1?' 🔥x'+S.streak:''}`;
  S.phase='playing';S.scoringPlayed=null;
  if(S.currentScore>=S.blindScore){render();setTimeout(()=>winBlind(),450);return;}
  if(S.handsLeft<=0){render();setTimeout(()=>{S.phase='gameover';render();},450);return;}
  render();
}

function discardSelected(){
  if(S.phase!=='playing')return;
  if(S.selected.length===0||S.discardsLeft<=0)return;
  const ids=[...S.selected];
  ids.forEach(id=>{const el=document.querySelector(`[data-cid="${id}"]`);if(el)el.classList.add('discard-out');});
  // Purple seal: create tarot for discarded cards
  ids.forEach(id=>{
    const card=S.hand.find(c=>c.id===id);
    if(card&&card.seal==='purple'){addConsumable(randKey(TAROTS));}
  });
  const discardedFaceCount=ids.map(id=>S.hand.find(c=>c.id===id)).filter(c=>c&&c.rank>=11&&c.rank<=13).length;
  setTimeout(()=>{
    if(discardedFaceCount>=3&&S.jokers.some(j=>j.key==='faceless')){S.money+=5;}
    S.hand=S.hand.filter(c=>!ids.includes(c.id));
    S.discardsLeft-=1;S.totalDiscards=(S.totalDiscards||0)+ids.length;
    S.roundDiscardCount=(S.roundDiscardCount||0)+1;
    // Green Joker penalty
    if(S.jokers.some(j=>j.key==='greenJoker'))S.greenJokerMult=Math.max(0,(S.greenJokerMult||0)-1);
    drawTo(S.handSize);
    applySort();
    S.justDealt=true;
    // FIX: clear selection after discard
    S.selected=[];
    S.streak=0; // Reset streak on discard
    S.message=`Đã bỏ ${ids.length} lá.`;
    render();
  },240);
}

function selectAll(){
  if(S.phase!=='playing')return;
  const toSelect=S.hand.slice(0,5).map(c=>c.id);
  S.selected=toSelect;render();
}
function deselectAll(){S.selected=[];render();}

function applySort(){
  if(S.sortMode==='rank'){S.hand.sort((a,b)=>a.rank-b.rank);}
  else if(S.sortMode==='suit'){const order={S:0,H:1,D:2,C:3};S.hand.sort((a,b)=>(order[a.suit]-order[b.suit])||(a.rank-b.rank));}
  // 'manual' mode: leave hand order untouched
}
function sortHand(mode){
  S.sortMode=mode;
  applySort();
  render();
}

function winBlind(){
  spawnConfetti();
  S.handsWon=(S.handsWon||0)+1;
  // Blue seals in hand: create Planet
  S.hand.forEach(c=>{if(c.seal==='blue'){addConsumable(randKey(PLANETS));}});
  // Midas: gold lá mặt in play
  const hasMidas=S.jokers.some(j=>j.key==='midas');
  let goldGain=0;
  S.hand.forEach(c=>{if(c.enh==='gold')goldGain+=3;else if(hasMidas&&c.rank>=11&&c.rank<=13)goldGain+=3;});
  // Perkeo
  if(S.jokers.some(j=>j.key==='perkeo')&&S.consumables.length>0){
    const c=S.consumables[Math.floor(Math.random()*S.consumables.length)];addConsumable(c.key);}
  let reward=blindRewardFor(S.blindIdx)+goldGain;
  S.jokers.forEach(j=>{const def=JOKERS[j.key];if(!def)return;if(def.passive==='roundEndMoney')reward+=def.passiveVal;if(def.passive==='cloud9')reward+=S.fullDeck.filter(c=>c.rank===9).length;if(def.passive==='reservedParking'){S.hand.forEach(c=>{if(c.rank>=11&&c.rank<=13&&Math.random()<0.5)reward+=1;});}if(def.passive==='moneyTree')reward+=Math.floor(S.money/10);});
  const interest=Math.min(5,Math.floor(S.money/5));reward+=interest;
  if(S.doubleMoneyCharge){reward*=2;S.doubleMoneyCharge=false;S.doubleMoneyApplied=true;}else{S.doubleMoneyApplied=false;}
  if(S.blindIdx===2&&S.investmentCharge){reward+=15;S.investmentCharge=false;S.investmentApplied=true;}else{S.investmentApplied=false;}
  S.money+=reward;S.lastReward=reward;
  S.phase='shop';buildShop();render();
}

function proceedAfterShop(){
  S.shopAllFree=false;
  S.blindIdx+=1;
  if(S.blindIdx>2){S.blindIdx=0;S.ante+=1;}
  if(S.ante>8){S.phase='win';render();return;}
  setupBlind();render();
}

