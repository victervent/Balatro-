function spawnConfetti(){
  const wrap=document.createElement('div');wrap.className='confetti-wrap';document.body.appendChild(wrap);
  const colors=['#f0b84b','#e0495a','#6f7bd6','#7fd18b','#9a5fc9','#3fb8a6'];
  for(let i=0;i<44;i++){
    const bit=document.createElement('div');bit.className='confetti-bit';
    bit.style.left=Math.random()*100+'%';
    bit.style.background=colors[Math.floor(Math.random()*colors.length)];
    const dur=(1.6+Math.random()*1.2).toFixed(2);
    bit.style.animationDuration=dur+'s';
    bit.style.animationDelay=(Math.random()*0.3)+'s';
    wrap.appendChild(bit);
  }
  setTimeout(()=>wrap.remove(),2400);
}
function spawnFloat(x,y,text,color){
  if(!text)return;
  const el=document.createElement('div');
  el.className='float-num';el.style.left=x+'px';el.style.top=y+'px';el.style.color=color||'#fff';el.textContent=text;
  document.body.appendChild(el);setTimeout(()=>el.remove(),980);
}
function pulseHud(hud){hud.classList.add('pulse');setTimeout(()=>hud.classList.remove('pulse'),180);}

function runScoreAnimation(build,played,onDone){
  const hud=document.createElement('div');
  hud.className='score-hud';
  hud.innerHTML=`<div class="hud-handname"></div><div class="hud-row"><span class="hud-chips">0</span><span class="hud-x">×</span><span class="hud-mult">0</span></div>`;
  document.body.appendChild(hud);
  let curChips=0,curMult=0,i=0;
  function step(){
    if(i>=build.steps.length){setTimeout(finish,550);return;}
    const st=build.steps[i];
    curChips+=st.chipDelta||0;if(st.multDelta)curMult+=st.multDelta;if(st.multMulti&&st.multMulti!==1)curMult*=st.multMulti;
    hud.querySelector('.hud-chips').textContent=Math.round(curChips);
    hud.querySelector('.hud-mult').textContent=Math.round(curMult*10)/10;
    hud.querySelector('.hud-handname').textContent=st.label||'';
    pulseHud(hud);
    if(st.targetSel){const el=document.querySelector(st.targetSel);if(el){el.classList.add('hit');setTimeout(()=>el.classList.remove('hit'),400);const r=el.getBoundingClientRect();spawnFloat(r.left+r.width/2,r.top,st.floatText,st.floatColor);}}
    i++;setTimeout(step,st.delay||150);
  }
  function finish(){
    const totalEl=document.createElement('div');totalEl.className='hud-total';totalEl.textContent='= '+build.total.toLocaleString()+' điểm';hud.appendChild(totalEl);
    setTimeout(()=>{hud.remove();onDone();},750);
  }
  step();
}

