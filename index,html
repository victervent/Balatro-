function anteBase(ante){
  const table=[300,800,2000,5000,11000,20000,35000,50000,110000];
  return table[Math.min(ante-1,table.length-1)];
}
function blindNameFor(idx){return idx===0?'Small Blind':idx===1?'Big Blind':'Boss Blind';}
function blindScoreFor(ante,idx){
  const base=anteBase(ante);
  if(idx===0)return Math.round(base);
  if(idx===1)return Math.round(base*1.5);
  return Math.round(base*2);
}
function blindRewardFor(idx){return idx===0?3:idx===1?4:5;}

function setupBlind(){
  S.debuffSuit=null;S.mustPlayFive=false;S.fishMode=false;S.blindHandMode=false;S.flintMode=false;
  S.handsLeft=S.baseHands;S.discardsLeft=S.baseDiscards;S.handSize=S.baseHandSize;
  S.currentScore=0;S.roundDiscardCount=0;
  S.blindScore=blindScoreFor(S.ante,S.blindIdx);
  S.boss=S.blindIdx===2?pickBoss():null;
  if(S.blindIdx===2)S.bossRerollPending=false;
  if(S.boss){
    const hasBossDisable=S.jokers.some(j=>JOKERS[j.key].passive==='disableBoss');
    if(!hasBossDisable)S.boss.apply(S);
  }
  S.deck=shuffle(S.fullDeck.map(c=>({...c})));
  S.hand=[];S.selected=[];
  S.ancientSuit=['S','H','D','C'][Math.floor(Math.random()*4)];
  S.phase='blind-intro';
  // Troubadour passive
  if(S.jokers.some(j=>j.key==='troubadour'))S.handSize+=2;
  if(S.jokers.some(j=>j.key==='turtleBean'))S.handSize+=Math.max(0,5-(S.ante-1));
}

function drawTo(n){
  const target=Math.min(n,S.handSize);
  while(S.hand.length<target&&S.deck.length>0){S.hand.push(S.deck.pop());}
}

function startPlaying(){
  drawTo(S.handSize);
  applySort();
  S.phase='playing';
  S.message='Chọn tối đa 5 lá để Chơi hoặc Bỏ bài.';
  S.justDealt=true;
  render();
}

function skipBlind(){
  if(S.blindIdx===2)return;
  const tagKey=rollTag();
  const def=TAGS[tagKey];
  const resultMsg=def.apply(S);
  S.blindIdx+=1;
  if(S.blindIdx>2){S.blindIdx=0;S.ante+=1;}
  if(S.ante>8){S.phase='win';render();return;}
  setupBlind();
  S.tagReveal={key:tagKey,resultMsg};
  render();
}
function dismissTagReveal(){
  S.tagReveal=null;
  if(S.pendingPackPicking){S.packPicking=S.pendingPackPicking;S.pendingPackPicking=null;}
  render();
}

