function buildShop(){
  S.shopAllFree=!!S.freeShopCharge;S.freeShopCharge=false;
  const jokerPool=Object.keys(JOKERS);
  const consumPool=[...Object.keys(TAROTS).map(k=>({type:'tarot',key:k})),...Object.keys(PLANETS).map(k=>({type:'planet',key:k}))];
  const offers={jokers:[],consumables:[],packs:[]};
  const jCount=S.shopJokerCount||2;
  for(let i=0;i<jCount;i++){offers.jokers.push({key:jokerPool[Math.floor(Math.random()*jokerPool.length)],edition:rollJokerEdition(S.editionBoost)});}
  if(S.guaranteedEdition&&offers.jokers[0]){offers.jokers[0].edition=S.guaranteedEdition;S.guaranteedEdition=null;}
  for(let i=0;i<2;i++){offers.consumables.push(consumPool[Math.floor(Math.random()*consumPool.length)]);}
  // Random pack in shop
  const packKeys=Object.keys(PACKS);
  offers.packs=[{key:packKeys[Math.floor(Math.random()*packKeys.length)]}];
  const availVouchers=Object.keys(VOUCHERS).filter(k=>!S.ownedVouchers[k]);
  offers.voucher=(Math.random()<0.35&&availVouchers.length>0)?{key:availVouchers[Math.floor(Math.random()*availVouchers.length)]}:null;
  if(offers.voucher){offers.voucher.cost=Math.round((VOUCHERS[offers.voucher.key].cost+(S.ante-1)*2)*(S.priceMult||1));}
  offers.voucherBought=false;
  S.shopOffers=offers;S.rerollCost=5;
}
function rerollShop(){
  if(S.shopAllFree){/* free */}
  else if(S.freeRerollCharges>0){S.freeRerollCharges-=1;}
  else{const cost=Math.max(1,S.rerollCost-(S.rerollDiscount||0));if(S.money<cost)return;S.money-=cost;S.rerollCost+=2;}
  const jokerPool=Object.keys(JOKERS);const consumPool=[...Object.keys(TAROTS).map(k=>({type:'tarot',key:k})),...Object.keys(PLANETS).map(k=>({type:'planet',key:k}))];
  const jCount=S.shopJokerCount||2;
  S.shopOffers.jokers=[];for(let i=0;i<jCount;i++){S.shopOffers.jokers.push({key:jokerPool[Math.floor(Math.random()*jokerPool.length)],edition:rollJokerEdition(S.editionBoost)});}
  S.shopOffers.consumables=[consumPool[Math.floor(Math.random()*consumPool.length)],consumPool[Math.floor(Math.random()*consumPool.length)]];
  render();
}
function buyJoker(idx){
  const offer=S.shopOffers.jokers[idx];if(!offer)return;
  const def=JOKERS[offer.key];const ed=JOKER_EDITIONS[offer.edition||'none']||JOKER_EDITIONS.none;
  const totalCost=S.shopAllFree?0:Math.max(1,Math.round((def.cost+(ed.costAdd||0))*(S.priceMult||1)));
  const needsSlot=offer.edition!=='negative';
  if(S.money<totalCost||(needsSlot&&activeJokerCount()>=S.maxJokerSlots))return;
  S.money-=totalCost;S.jokers.push({uid:uid(),key:offer.key,edition:offer.edition||'none'});
  if(def.passive==='handSizeUp'){S.handSize+=1;S.baseHandSize+=1;}
  if(def.key==='blackHole'){Object.keys(S.handLevels).forEach(k=>{S.handLevels[k]+=1;});}
  if(def.passive==='cartomancer'){addConsumable(randKey(TAROTS));}
  if(def.passive==='riffraff'){const commons=Object.keys(JOKERS).filter(k=>JOKERS[k].rarity==='C');for(let i=0;i<2;i++){if(activeJokerCount()>=S.maxJokerSlots)break;S.jokers.push({uid:uid(),key:commons[Math.floor(Math.random()*commons.length)],edition:'none'});}}
  if(def.passive==='certificate'){S.hand.push(randomStandardCard());}
  S.shopOffers.jokers[idx]=null;render();
}
function buyVoucher(){
  if(!S.shopOffers.voucher||S.shopOffers.voucherBought)return;
  const{key}=S.shopOffers.voucher;const cost=S.shopAllFree?0:S.shopOffers.voucher.cost;
  if(S.money<cost)return;
  S.money-=cost;VOUCHERS[key].apply(S);S.ownedVouchers[key]=true;S.shopOffers.voucherBought=true;render();
}
function buyConsumable(idx){
  const item=S.shopOffers.consumables[idx];if(!item)return;
  const cost=S.shopAllFree?0:Math.max(1,Math.round((item.type==='tarot'?TAROTS[item.key].cost:3)*(S.priceMult||1)));
  if(S.money<cost||S.consumables.length>=S.maxConsumableSlots)return;
  S.money-=cost;S.consumables.push({uid:uid(),type:item.type,key:item.key});S.shopOffers.consumables[idx]=null;render();
}
function buyPack(idx){
  const offer=S.shopOffers.packs[idx];if(!offer)return;
  const def=PACKS[offer.key];
  const isFree=S.freePackCharge>0||S.shopAllFree;
  const cost=isFree?0:Math.max(1,Math.round(def.cost*(S.priceMult||1)));
  if(!isFree&&S.money<cost)return;
  if(S.freePackCharge>0&&!S.shopAllFree)S.freePackCharge-=1;else if(!S.shopAllFree)S.money-=cost;
  S.shopOffers.packs[idx]=null;
  openPack(def.kind);
}
function openPack(kind){
  let options=[];
  if(kind==='tarot'||kind==='mega_tarot'){const pool=Object.keys(TAROTS);const n=kind==='mega_tarot'?5:3;for(let i=0;i<n;i++)options.push({type:'tarot',key:pool[Math.floor(Math.random()*pool.length)]});}
  else if(kind==='planet'){const pool=Object.keys(PLANETS);for(let i=0;i<3;i++)options.push({type:'planet',key:pool[Math.floor(Math.random()*pool.length)]});}
  else if(kind==='card'){for(let i=0;i<3;i++)options.push({type:'card',card:randomStandardCard()});}
  else if(kind==='spectral'){const pool=Object.keys(SPECTRALS);for(let i=0;i<2;i++)options.push({type:'spectral',key:pool[Math.floor(Math.random()*pool.length)]});}
  S.packPicking={options,kind};render();
}
function pickFromPack(idx){
  if(!S.packPicking)return;
  const opt=S.packPicking.options[idx];
  if(opt.type==='tarot'||opt.type==='planet'){
    if(S.consumables.length<S.maxConsumableSlots){S.consumables.push({uid:uid(),type:opt.type,key:opt.key});S.message=`Nhận ${opt.type==='tarot'?TAROTS[opt.key].name:PLANETS[opt.key].name}.`;}
    else{S.message='Hết chỗ chứa!';}
  } else if(opt.type==='card'){
    S.fullDeck.push(opt.card);S.message='Đã thêm lá bài vào bộ bài.';
  } else if(opt.type==='spectral'){
    const def=SPECTRALS[opt.key];const msg=def.effect([],S);S.message=`${def.name}: ${msg}`;
  }
  S.packPicking=null;render();
}
function closePack(){S.packPicking=null;render();}

function addConsumable(key){
  if(S.consumables.length>=S.maxConsumableSlots)return false;
  const type=PLANETS[key]?'planet':'tarot';
  S.consumables.push({uid:uid(),type,key});return true;
}
function sellJoker(uidVal){
  const idx=S.jokers.findIndex(j=>j.uid===uidVal);if(idx<0)return;
  const val=Math.max(1,Math.floor(JOKERS[S.jokers[idx].key].cost/2));S.money+=val;S.jokers.splice(idx,1);
  S.campfireCount=(S.campfireCount||0)+1;
  render();
}
function sellConsumable(uidVal){
  const idx=S.consumables.findIndex(j=>j.uid===uidVal);if(idx<0)return;
  const def=S.consumables[idx].type==='tarot'?TAROTS[S.consumables[idx].key]:{cost:3};
  S.money+=Math.max(1,Math.floor((def.cost||3)/2));S.consumables.splice(idx,1);render();
}

// ======================================================
// USE CONSUMABLE
// ======================================================
function beginUseConsumable(uidVal){
  const idx=S.consumables.findIndex(c=>c.uid===uidVal);if(idx<0)return;
  const c=S.consumables[idx];
  if(c.type==='planet'){
    const hand=PLANETS[c.key].hand;
    if(S.observatoryMode){
      // Observatory: planet gives x3 mult instead of level up
      S.message=`${PLANETS[c.key].name}: Observatory mode — bị giữ lại cho scoring!`;
    } else {
      S.handLevels[hand]=Math.min(10,(S.handLevels[hand]||1)+1);
      S.lastConsumable={type:'planet',key:c.key};
      S.consumables.splice(idx,1);
      S.planetUsedCount=(S.planetUsedCount||0)+1;
      S.message=`${PLANETS[c.key].name}: ${HAND_TYPES[hand].name} lên cấp ${S.handLevels[hand]}!`;
    }
    render();return;
  }
  const def=TAROTS[c.key];
  if(def.max===0){const msg=def.effect([],S);S.lastConsumable={type:'tarot',key:c.key};S.consumables.splice(idx,1);S.tarotUsedCount=(S.tarotUsedCount||0)+1;S.message=`${def.name}: ${msg}`;render();return;}
  S.selectMode={consumUid:uidVal,min:def.min,max:def.max};S.selected=[];
  S.message=`Chọn ${def.min===def.max?def.max:('0-'+def.max)} lá cho ${def.name}, rồi bấm "Dùng".`;render();
}
function confirmUseConsumable(){
  if(!S.selectMode)return;
  const{consumUid,min,max}=S.selectMode;
  if(S.selected.length<min||S.selected.length>max){S.message=`Cần chọn từ ${min} đến ${max} lá.`;render();return;}
  const idx=S.consumables.findIndex(c=>c.uid===consumUid);if(idx<0){S.selectMode=null;render();return;}
  const c=S.consumables[idx];const def=TAROTS[c.key];
  const targets=S.hand.filter(h=>S.selected.includes(h.id));
  const msg=def.effect(targets,S);S.lastConsumable={type:'tarot',key:c.key};
  S.consumables.splice(idx,1);S.selected=[];S.selectMode=null;S.tarotUsedCount=(S.tarotUsedCount||0)+1;
  S.message=`${def.name}: ${msg}`;render();
}
function cancelUseConsumable(){S.selectMode=null;S.selected=[];S.message='Đã hủy.';render();}

