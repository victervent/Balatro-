/* ================= 4. HIỆU ỨNG ĐÁNH BÀI + ĂN ĐIỂM ================= */
function countUp(el,a,b,ms,fmt){const t0=performance.now();(function f(t){const p=Math.min(1,(t-t0)/ms),e=1-Math.pow(1-p,3),v=a+(b-a)*e;el.textContent=fmt?fmt(v):Math.round(v).toLocaleString();if(p<1&&el.isConnected)requestAnimationFrame(f);})(t0);}
function burstAt(x,y,color,n){for(let i=0;i<n;i++){const p=document.createElement('div');p.className='burst';p.style.left=x+'px';p.style.top=y+'px';p.style.background=color;p.style.color=color;const a=Math.random()*Math.PI*2,d=40+Math.random()*100;p.style.setProperty('--dx',Math.cos(a)*d+'px');p.style.setProperty('--dy',Math.sin(a)*d+'px');document.body.appendChild(p);setTimeout(()=>p.remove(),700);}}
function ring(x,y,color){const r=document.createElement('div');r.className='ring-fx';r.style.left=x+'px';r.style.top=y+'px';r.style.borderColor=color||'#fff';document.body.appendChild(r);setTimeout(()=>r.remove(),600);}
function flash(color){const f=document.createElement('div');f.className='flash-screen';f.style.background='radial-gradient(circle at 50% 35%,'+color+'99,transparent 65%)';document.body.appendChild(f);setTimeout(()=>f.remove(),650);}
const heatOf=m=>m>=150?3:m>=60?2:m>=20?1:0;

window.runScoreAnimation=function(build,played,onDone){
 let fast=false,done=false,i=0,curChips=0,curMult=0;
 const sc=new Set((build.scoring||[]).map(c=>c.id));
 const stage=document.createElement('div');stage.className='play-stage';
 stage.innerHTML=played.map(c=>cardHTML(c,false).replace('class="card ','class="card in-play '+(sc.has(c.id)?'':'dimmed '))).join('');
 const skip=document.createElement('div');skip.className='skip-layer';skip.innerHTML='<span>Chạm để tua nhanh ⏩</span>';
 skip.onclick=()=>{fast=true;skip.classList.add('gone');};
 const hud=document.createElement('div');hud.className='score-hud';hud.dataset.heat=0;
 hud.innerHTML='<div class="hud-handname"></div><div class="hud-row"><span class="hud-chips">0</span><span class="hud-x">×</span><span class="hud-mult">0</span></div>';
 document.body.append(skip,stage,hud);
 [...stage.children].forEach((el,k)=>{if(el.animate)el.animate([{transform:'translateY(130px) rotate(14deg) scale(.5)',opacity:0},{transform:'none',opacity:1}],{duration:380,delay:k*70,easing:'cubic-bezier(.2,1.2,.3,1)',fill:'backwards'});});

 function step(){
  if(done)return;
  if(i>=build.steps.length){setTimeout(finish,fast?100:Math.round(420*spd()));return;}
  const st=build.steps[i];
  curChips+=st.chipDelta||0;if(st.multDelta)curMult+=st.multDelta;if(st.multMulti&&st.multMulti!==1)curMult*=st.multMulti;
  hud.querySelector('.hud-chips').textContent=Math.round(curChips);
  hud.querySelector('.hud-mult').textContent=Math.round(curMult*10)/10;
  hud.querySelector('.hud-handname').textContent=st.label||'';
  hud.dataset.heat=heatOf(curMult);
  pulseHud(hud);
  if(window.playHitSound)playHitSound(st,i);
  let shown=false;
  if(st.targetSel){const el=document.querySelector(st.targetSel);if(el){el.classList.add('hit');setTimeout(()=>el.classList.remove('hit'),400);const r=el.getBoundingClientRect();spawnFloat(r.left+r.width/2,r.top,st.floatText,st.floatColor);if(st.floatText)ring(r.left+r.width/2,r.top+r.height/2,st.floatColor);shown=true;}}
  if(!shown&&st.floatText){const r=hud.getBoundingClientRect();spawnFloat(r.left+r.width/2,r.bottom+8,st.floatText,st.floatColor);}
  i++;setTimeout(step,Math.max(18,(st.delay||150)*(fast?.18:1)));
 }
 function finish(){
  if(done)return;
  hud.querySelector('.hud-chips').textContent=Math.round(build.chips);
  hud.querySelector('.hud-mult').textContent=Math.round(build.mult*10)/10;
  hud.dataset.heat=heatOf(build.mult);pulseHud(hud);
  const t=document.createElement('div');t.className='hud-total';t.textContent='= 0 điểm';hud.appendChild(t);
  const dur=fast?250:Math.round(650*spd());
  countUp(t,0,build.total,dur,v=>'= '+Math.round(v).toLocaleString()+' điểm');
  if(window.playScoreExplosion)playScoreExplosion(build.total,S.blindScore);
  const ratio=build.total/Math.max(1,S.blindScore),hr=hud.getBoundingClientRect();
  burstAt(hr.left+hr.width/2,hr.top+hr.height/2,ratio>=.5?'#ffd76a':'#7fe3ff',ratio>=1?36:ratio>=.25?24:12);
  if(ratio>=.25)flash(ratio>=1?'#ff6b6b':'#ffd76a');
  setTimeout(fly,dur+(fast?150:380));
 }
 function fly(){
  if(done)return;
  const hr=hud.getBoundingClientRect();
  const tgt=document.querySelector('.score-box .cur')||document.querySelector('.score-box');
  const tr=tgt?tgt.getBoundingClientRect():{left:innerWidth/2,top:60,width:0,height:0};
  const x0=hr.left+hr.width/2,y0=hr.bottom-20,x1=tr.left+tr.width/2,y1=tr.top+tr.height/2;
  const f=document.createElement('div');f.className='fly-score';f.textContent='+'+build.total.toLocaleString();document.body.appendChild(f);
  hud.style.transition='opacity .25s';hud.style.opacity='0';
  [...stage.children].forEach(el=>{if(el.animate)el.animate([{opacity:1},{transform:'translateY(-80px) scale(.6)',opacity:0}],{duration:300,fill:'forwards',easing:'ease-in'});});
  const dur=fast?220:520;
  if(f.animate)f.animate([{transform:'translate('+x0+'px,'+y0+'px) translate(-50%,-50%) scale(1.2)',opacity:1},{transform:'translate('+x1+'px,'+y1+'px) translate(-50%,-50%) scale(.5)',opacity:.3}],{duration:dur,easing:'cubic-bezier(.6,0,.9,.5)',fill:'forwards'});
  setTimeout(()=>{f.remove();cleanup();},dur+30);
 }
 function cleanup(){if(done)return;done=true;hud.remove();skip.remove();stage.remove();onDone();}
 setTimeout(step,150+played.length*70);
};

