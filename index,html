const RO=['C','U','R','L'];
function doFusion(f){
 const others=S.jokers.filter(j=>j.uid!==f.uid);
 if(others.length<2){say('Cần ≥2 Joker khác để Fusion — giữ lại làm Joker thường','#ffb3ab');return;}
 const a=others[others.length-2],b=others[others.length-1];
 const hi=Math.max(RO.indexOf(JOKERS[a.key].rarity),RO.indexOf(JOKERS[b.key].rarity));
 const rar=RO[Math.min(3,hi+1)];
 const pool=Object.keys(JOKERS).filter(k=>JOKERS[k].rarity===rar&&k!=='fusion');
 const key=pick(pool);
 const ed=(a.edition==='negative'||b.edition==='negative')?'negative':(Math.random()<0.2?'poly':'none');
 S.jokers=S.jokers.filter(j=>![a.uid,b.uid,f.uid].includes(j.uid));
 S.jokers.push({uid:uid(),key,edition:ed});
 say('🔗 FUSION! → '+JOKERS[key].name,'#c9a0ff');
}
