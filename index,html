function restructureShop(){
 const w=document.querySelector('.shop-wrap');if(!w||w.dataset.v17)return;w.dataset.v17='1';
 const kids=[...w.children],head=kids[0],parts={j:[],c:[],p:[],o:[]};let cur='j';
 kids.slice(1).forEach(el=>{
  if(el.classList.contains('controls'))return;
  if(el.classList.contains('row-label')){const t=el.textContent;cur=t.includes('TAROT')?'c':(t.includes('BOOSTER')||t.includes('VOUCHER'))?'p':'j';}
  else if(el.classList.contains('panel'))cur='o';
  parts[cur].push(el);
 });
 const bar=document.createElement('div');bar.className='shop-tabs';
 const holder=document.createElement('div');
 [['j','🃏 Joker'],['c','🎴 Tarot/Planet'],['p','📦 Gói & Voucher'],['o','🎒 Đang có']].forEach(([k,label])=>{
  const sec=document.createElement('div');sec.className='shop-sec';sec.dataset.t=k;
  parts[k].forEach(el=>sec.appendChild(el));holder.appendChild(sec);
  const n=k==='o'?sec.querySelectorAll('.own-chip').length:sec.querySelectorAll('.shop-item').length;
  const b=document.createElement('button');b.className='shop-tab';b.dataset.t=k;b.innerHTML=label+(n?' <b>'+n+'</b>':'');b.onclick=()=>shopTab(k);bar.appendChild(b);
 });
 head.after(bar);bar.after(holder);shopTab(window._shopTab);
}

