  if(key&&!n.classList.contains('ttl-'+key))setTitleClass(n,key);
 });
}
let pend=false;
new MutationObserver(()=>{if(pend)return;pend=true;requestAnimationFrame(()=>{pend=false;decor();});}).observe(document.body,{childList:true,subtree:true});

/* ---------- 3. SỔ SƯU TẬP JOKER ---------- */
const BOOK_LS='arcanumJokerBookV1',META_LS2='arcanumMetaV1';
const RN={C:'Thường',U:'Hiếm',R:'Rất hiếm',L:'Huyền thoại'};
const RC={C:'#c9b38a',U:'#6fa8dc',R:'#b48be0',L:'#f0b84b'};
const REW={C:3,U:5,R:8,L:15};   // số xu khi sưu tập đủ 1 nhóm — chỉnh ở đây
let BOOK={};try{BOOK=JSON.parse(localStorage.getItem(BOOK_LS))||{};}catch(e){}
BOOK.seen=BOOK.seen||{};BOOK.claimed=BOOK.claimed||{};
const saveBook=()=>{try{localStorage.setItem(BOOK_LS,JSON.stringify(BOOK));}catch(e){}};
function markSeen(){
 if(!S||!S.jokers)return;
 let n=0;const add=k=>{if(k&&JOKERS[k]&&!BOOK.seen[k]){BOOK.seen[k]=1;n++;}};
 S.jokers.forEach(j=>add(j.key));
 if(S.shopOffers&&S.shopOffers.jokers)S.shopOffers.jokers.forEach(o=>o&&add(o.key));
 if(n){saveBook();say('📖 Sổ Joker: +'+n+' lá mới!','#c9a0ff');}
}
const _r=render;
render=function(){_r();try{markSeen();}catch(e){console.error(e);}};

function drawBook(){
 let m=document.getElementById('jbookModal');
 if(!m){m=document.createElement('div');m.id='jbookModal';m.className='overlay';m.onclick=e=>{if(e.target===m)m.remove();};document.body.appendChild(m);}
 const keys=Object.keys(JOKERS),got=keys.filter(k=>BOOK.seen[k]).length;
 let body='';
 ['C','U','R','L'].forEach(r=>{
  const list=keys.filter(k=>JOKERS[k].rarity===r).sort((a,b)=>JOKERS[a].cost-JOKERS[b].cost||JOKERS[a].name.localeCompare(JOKERS[b].name,'vi'));
  if(!list.length)return;
  const n=list.filter(k=>BOOK.seen[k]).length,full=n===list.length,pct=Math.round(n/list.length*100);
  const act=BOOK.claimed[r]?'<span class="jb-done">✓ Đã nhận thưởng</span>':full?`<button class="btn small" onclick="jbClaim('${r}')">🎁 Nhận ${REW[r]} 🪙</button>`:`<span class="jb-need">Thưởng: ${REW[r]} 🪙</span>`;
  const cards=list.map(k=>{
   const d=JOKERS[k];
   if(BOOK.seen[k])return`<div class="jb-card lit r-${r}"><div class="jb-ic">${d.icon}</div><div class="lib-name">${d.name}</div><div class="lib-desc">${d.desc}</div></div>`;
   return`<div class="jb-card dark"><div class="jb-q">?</div><div class="lib-name">???</div><div class="lib-desc">${r==='L'?'Gợi ý: chỉ ra từ The Soul (Spectral).':'Chưa từng gặp.'}</div></div>`;
  }).join('');
  body+=`<div class="jb-head" style="--c:${RC[r]}"><div><b style="color:${RC[r]}">— ${RN[r]} —</b> <span class="jb-cnt">${n}/${list.length}</span></div>${act}</div><div class="jb-bar"><i style="width:${pct}%;background:${RC[r]}"></i></div><div class="jb-grid">${cards}</div>`;
 });
 m.innerHTML=`<div class="modal" style="max-width:760px"><h2>📖 Sổ sưu tập Joker</h2><p>Đã khám phá <b style="color:var(--gold)">${got}/${keys.length}</b> Joker. Gặp trong Shop hoặc sở hữu là được ghi vào sổ. Sưu tập đủ 1 nhóm độ hiếm để nhận Xu!</p><div style="max-height:62vh;overflow-y:auto;padding-right:4px">${body}</div><div class="controls" style="margin-top:14px"><button class="btn" onclick="document.getElementById('jbookModal').remove()">Đóng</button></div></div>`;
}
window.toggleJokerBook=function(){const ex=document.getElementById('jbookModal');if(ex){ex.remove();return;}drawBook();};
window.jbClaim=function(r){
 const keys=Object.keys(JOKERS).filter(k=>JOKERS[k].rarity===r);
 if(BOOK.claimed[r]||!keys.every(k=>BOOK.seen[k]))return;
 const M=window.__META;if(!M)return;
 M.coins=(M.coins||0)+REW[r];
 try{localStorage.setItem(META_LS2,JSON.stringify(M));}catch(e){}
 BOOK.claimed[r]=1;saveBook();
 say('🪙 +'+REW[r]+' Xu! Hoàn thành nhóm '+RN[r],'#ffd76a');
 drawBook();
};

// Mã Dio: mở sáng toàn bộ Joker
const _ac=window.applyCode;
window.applyCode=function(){
 const inp=document.getElementById('cheatCode');const v=((inp&&inp.value)||'').trim();
 if(v==='Dio'){
  Object.keys(JOKERS).forEach(k=>BOOK.seen[k]=1);saveBook();
  toastDeck('📖 DIO! Đã mở sáng toàn bộ Joker trong Sổ!');
  if(inp)inp.value='';return;
 }
 _ac();
};

// Nút mở sổ: ở menu chính + trong dock
const _rds=renderDeckSelect;
renderDeckSelect=function(){
 _rds();
 const app=document.getElementById('app');if(!app)return;
 const ctr=app.querySelector('.controls');
 if(ctr&&!app.querySelector('[data-jbook]'))ctr.insertAdjacentHTML('beforeend',`<button class="btn ghost" data-jbook onclick="toggleJokerBook()">📖 Sổ Joker · ${Object.keys(JOKERS).filter(k=>BOOK.seen[k]).length}/${Object.keys(JOKERS).length}</button>`);
};
(function(){
 const b=document.createElement('button');b.className='rules-fab dock-btn';b.textContent='📖';b.title='Sổ sưu tập Joker';b.onclick=()=>toggleJokerBook();
 const items=document.querySelector('#dock .dock-items');
 if(items)items.appendChild(b);
 else{b.style.cssText='position:fixed;bottom:64px;left:14px;z-index:60;';document.body.appendChild(b);}
})();

/* ---------- 4. CSS ---------- */
const css=document.createElement('style');
css.textContent=`
/* ===== DANH HIỆU ===== */
.ttl{display:inline-block;position:relative;overflow:hidden;padding:3px 14px;border-radius:999px;font-family:var(--font-display);font-weight:800;letter-spacing:.4px;border:1px solid;background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent!important;-webkit-text-fill-color:transparent;}
.ttl::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 38%,rgba(255,255,255,.75) 50%,transparent 62%);transform:translateX(-130%);animation:ttlSweep 3.2s ease-in-out infinite;pointer-events:none;-webkit-text-fill-color:initial;}
@keyframes ttlFlow{to{background-position:250% 0;}}
@keyframes ttlSweep{0%{transform:translateX(-130%);}55%,100%{transform:translateX(130%);}}
@keyframes ttlFlicker{0%,100%{filter:drop-shadow(0 0 4px #ff3a3a);}50%{filter:drop-shadow(0 0 12px #ffb347);}}
@keyframes ttlBeat{0%,100%{transform:scale(1);}50%{transform:scale(1.09);}}
@keyframes ttlHue{to{filter:hue-rotate(360deg) drop-shadow(0 0 6px #c084fc);}}
@keyframes ttlGlow{0%,100%{filter:drop-shadow(0 0 5px #ff8ad8);}50%{filter:drop-shadow(0 0 14px #7fe3ff);}}
@keyframes ttlFloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-3px);}}
.ttl-newbie{background-image:linear-gradient(90deg,#6fe08a,#e2ffc0,#6fe08a);border-color:#6fe08a99;box-shadow:inset 0 0 10px #6fe08a33;animation:ttlFlow 3s linear infinite;}
.ttl-bosshunter{background-image:linear-gradient(90deg,#ff3a3a,#ffb347,#ff3a3a);border-color:#ff5a5aaa;box-shadow:inset 0 0 12px #ff3a3a44;animation:ttlFlow 1.6s linear infinite,ttlFlicker 1.2s ease-in-out infinite;}
.ttl-tungT{background-image:linear-gradient(90deg,#ffd76a,#fff3b0,#ffb300,#ffd76a);border-color:#ffd76acc;box-shadow:inset 0 0 12px #ffd76a44;animation:ttlFlow 2.4s linear infinite,ttlBeat .9s ease-in-out infinite;}
.ttl-gamblerT{background-image:linear-gradient(90deg,#c084fc,#ff8ad8,#7fe3ff,#c084fc);border-color:#c084fcaa;box-shadow:inset 0 0 12px #c084fc44;animation:ttlFlow 2.5s linear infinite,ttlHue 6s linear infinite;}
.ttl-zodiacT{background-image:linear-gradient(90deg,#7fe3ff,#ffffff,#8fa6ee,#7fe3ff);border-color:#7fe3ffaa;box-shadow:inset 0 0 14px #7fe3ff44,0 0 10px #7fe3ff44;animation:ttlFlow 3.5s linear infinite,ttlFloat 2.6s ease-in-out infinite;}
.ttl-masterT{background-image:linear-gradient(90deg,#f0b84b,#fff1b8,#c9902f,#f0b84b);border-color:#f0b84bcc;box-shadow:inset 0 0 14px #f0b84b44,0 0 12px #f0b84b55;animation:ttlFlow 2.2s linear infinite;}
.ttl-lordT{background-image:linear-gradient(90deg,#ff5a5a,#ffd76a,#7fe37f,#7fe3ff,#c084fc,#ff5a5a);background-size:400% 100%;border-color:#ffd76a;box-shadow:inset 0 0 16px #ffffff22,0 0 18px #ff8ad855;animation:ttlFlow 3s linear infinite,ttlGlow 2s ease-in-out infinite,ttlFloat 2.4s ease-in-out infinite;}
.ttl-lordT::before{content:"👑";position:absolute;left:3px;top:-1px;font-size:.7em;-webkit-text-fill-color:initial;}
.ttl-lordT{padding-left:20px;}
.lib-name.ttl{display:inline-block;margin:0 auto;}
@media(prefers-reduced-motion:reduce){.ttl,.ttl::after{animation:none!important;}}
/* ===== SỔ JOKER ===== */
.jb-head{display:flex;justify-content:space-between;align-items:center;margin:14px 0 4px;font-family:var(--font-display);}
.jb-cnt{font-family:var(--font-mono);font-size:.8rem;color:var(--text-lo);margin-left:6px;}
.jb-done{color:var(--good);font-size:.8rem;font-weight:700;}
.jb-need{color:var(--text-lo);font-size:.75rem;}
.jb-bar{height:6px;border-radius:4px;background:#07190f;overflow:hidden;margin-bottom:8px;}
.jb-bar i{display:block;height:100%;border-radius:4px;transition:width .5s;}
.jb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:8px;}
.jb-card{position:relative;overflow:hidden;border-radius:12px;padding:8px 6px;text-align:center;border:2px solid var(--panel-edge);}
.jb-card .lib-name{font-family:var(--font-display);font-weight:700;font-size:.72rem;margin-top:2px;}
.jb-card .lib-desc{font-size:.58rem;color:var(--text-lo);line-height:1.25;min-height:2.6em;}
.jb-ic{font-size:1.6rem;}
.jb-card.lit{background:linear-gradient(180deg,#1a5a45,#0e3527);animation:jbGlow 2.8s ease-in-out infinite;}
.jb-card.lit::after{content:"";position:absolute;top:0;left:-70%;width:40%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,.3),transparent);transform:skewX(-20deg);animation:idleShine 4s ease-in-out infinite;}
.jb-card.r-C{border-color:#c9b38a;--g:201,179,138;}
.jb-card.r-U{border-color:#3f6fae;--g:63,111,174;}
.jb-card.r-R{border-color:#8a3fae;--g:138,63,174;}
.jb-card.r-L{border-color:#e0a030;--g:240,184,75;}
@keyframes jbGlow{0%,100%{box-shadow:0 0 6px 0 rgba(var(--g),.35);}50%{box-shadow:0 0 16px 4px rgba(var(--g),.7);}}
.jb-card.dark{background:rgba(0,0,0,.35);border-style:dashed;opacity:.75;}
.jb-q{font-family:var(--font-mono);font-size:2rem;color:rgba(255,255,255,.28);animation:ttlFloat 3s ease-in-out infinite;}
`;
document.head.appendChild(css);

decor();
if(!S)renderDeckSelect();
})();
</script>

