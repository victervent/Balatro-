  droll:{name:'Droll Joker',icon:'🎭',cost:5,rarity:'C',desc:'+10 Mult nếu là Thùng.',calc:(c)=>({mult:(c.handType==='Flush'||c.handType==='StraightFlush'||c.handType==='FlushHouse'||c.handType==='FlushFive')?10:0})},
