let drag=null,suppress=false;
const SEL='.card[data-cid], .joker-card[data-juid], .own-chip[data-juid]';
function canDrag(el){
 if(!S)return false;
 if(el.dataset.cid)return S.phase==='playing';
 return S.phase==='playing'||S.phase==='shop';
}
function reorder(arr,key,fromId,toId,after){
 const i=arr.findIndex(x=>x[key]===fromId);if(i<0)return;
 const m=arr.splice(i,1)[0];
 let t=toId==null?arr.length:arr.findIndex(x=>x[key]===toId);
 if(t<0)t=arr.length;else if(after)t++;
 arr.splice(t,0,m);
}
document.addEventListener('pointerdown',e=>{
 if(e.pointerType==='mouse'&&e.button!==0)return;
 const el=e.target.closest&&e.target.closest(SEL);
 if(!el||e.target.closest('button')||!canDrag(el))return;
 drag={el,id:el.dataset.cid||el.dataset.juid,type:el.dataset.cid?'card':'joker',x0:e.clientX,y0:e.clientY,pid:e.pointerId,active:false,ghost:null,over:null,parent:el.parentElement};
});
document.addEventListener('pointermove',e=>{
 if(!drag||e.pointerId!==drag.pid)return;
 if(!drag.active){
  if(Math.hypot(e.clientX-drag.x0,e.clientY-drag.y0)<7)return;
  const el=drag.el,r=el.getBoundingClientRect();
  drag.active=true;drag.dx=drag.x0-r.left;drag.dy=drag.y0-r.top;
  const g=el.cloneNode(true);['data-cid','data-juid','id','onclick','onmousedown'].forEach(a=>g.removeAttribute(a));
  g.classList.add('drag-ghost');g.style.width=r.width+'px';g.style.height=r.height+'px';
  document.body.appendChild(g);drag.ghost=g;el.classList.add('dragging');
  try{el.setPointerCapture(drag.pid);}catch(_){}
 }
 drag.ghost.style.transform=`translate(${e.clientX-drag.dx}px,${e.clientY-drag.dy}px) rotate(4deg) scale(1.08)`;
 const t=document.elementFromPoint(e.clientX,e.clientY);
 const sel=drag.type==='card'?'.card[data-cid]':(drag.el.classList.contains('own-chip')?'.own-chip[data-juid]':'.joker-card[data-juid], .slot-empty');
 const over=t&&t.closest?t.closest(sel):null;
 const ok=(over&&over!==drag.el&&over.parentElement===drag.parent)?over:null;
 if(drag.over!==ok){if(drag.over)drag.over.classList.remove('drop-target');if(ok)ok.classList.add('drop-target');drag.over=ok;}
 if(e.cancelable)e.preventDefault();
},{passive:false});
function finish(e,cancel){
 if(!drag||e.pointerId!==drag.pid)return;
 const d=drag;drag=null;
 if(!d.active)return;
 if(d.ghost)d.ghost.remove();
 d.el.classList.remove('dragging');if(d.over)d.over.classList.remove('drop-target');
 suppress=true;setTimeout(()=>{suppress=false;},120);
 if(cancel||!d.over||!d.el.isConnected)return;
 const r=d.over.getBoundingClientRect(),after=e.clientX>r.left+r.width/2;
 if(d.type==='card'){reorder(S.hand,'id',d.id,d.over.dataset.cid,after);S.sortMode='manual';}
 else reorder(S.jokers,'uid',d.id,d.over.dataset.juid||null,after);
 render();
}
document.addEventListener('pointerup',e=>finish(e,false));
document.addEventListener('pointercancel',e=>finish(e,true));
document.addEventListener('click',e=>{if(suppress){e.stopPropagation();e.preventDefault();suppress=false;}},true);

