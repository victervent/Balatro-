function predictHand(){
  if(!S.selected.length)return'';
  const cards=S.hand.filter(c=>S.selected.includes(c.id));
  const{type}=evaluateHand(cards);
  const ht=HAND_TYPES[type];if(!ht)return'';
  const lvl=S.handLevels[type]||1;
  return`${ht.name} Cấp ${lvl} (${(ht.chips+ht.chipInc*(lvl-1))} × ${(ht.mult+ht.multInc*(lvl-1))})`;
}

