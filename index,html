const _ev=evaluateHand;
function chain(rs,n,gap){for(let i=0;i<rs.length;i++){const c=[rs[i]];for(let j=i+1;j<rs.length&&c.length<n;j++){if(rs[j]-c[c.length-1]<=gap)c.push(rs[j]);else break;}if(c.length>=n)return c.slice(0,n);}return null;}
evaluateHand=function(cs){
 const r=_ev(cs);
 try{
  if(!S||!S.jokers||cs.length<4)return r;
  const ff=has('fourFingers'),sh=has('shortcut');
  if(!ff&&!sh)return r;
  if(!['HighCard','Pair','TwoPair','ThreeKind'].includes(r.type))return r;
  const need=ff?4:5,gap=sh?2:1,rs=[...new Set(cs.map(c=>c.rank))].sort((a,b)=>a-b);
  const ch=chain(rs,need,gap)||(rs.includes(14)?chain([1,...rs.filter(x=>x!==14)],need,gap):null);
  let fl=null;for(const su of['S','H','D','C']){const m=cs.filter(c=>c.suit===su||c.enh==='wild');if(m.length>=need){fl=m;break;}}
  let scS=null;if(ch){scS=[];new Set(ch.map(x=>x===1?14:x)).forEach(rk=>scS.push(cs.find(c=>c.rank===rk)));}
  if(scS&&fl&&scS.every(c=>fl.includes(c)))return{type:'StraightFlush',scoring:scS};
  if(scS)return{type:'Straight',scoring:scS};
  if(fl)return{type:'Flush',scoring:fl};
 }catch(e){}
 return r;
};

